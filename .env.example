# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=True

# Email Headers
EMAIL_FROM="Daily Bread <your_email@gmail.com>"
EMAIL_TO=stanley@example.com
EMAIL_SUBJECT="Daily Bread - Edição de Hoje"

# AI Provider Configuration
# Supported: copilot (default)
AI_PROVIDER=copilot

# Application Paths
STATE_PATH=temp/state.json
LOGS_DIR=temp/logs
