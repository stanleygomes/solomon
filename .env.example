# Logging
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
LOG_ROTATION="10 MB"
LOG_RETENTION="10 days"

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=True

# Email Headers
EMAIL_FROM="Solomon <bot.email@gmail.com>"
EMAIL_TO=your.email@gmail.com
EMAIL_SUBJECT=""

# AI Providers
AI_PROVIDER=copilot
