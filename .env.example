# Logging
LOG_FILE=logs/{time:YYYY-MM-DD}.log
LOG_LEVEL=DEBUG
LOG_ROTATION="10 MB"
LOG_RETENTION="30 days"

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=True

# Email Headers
EMAIL_FROM="Solomon <bot.email@gmail.com>"
EMAIL_TO=your.email@gmail.com

# AI Providers
AI_PROVIDER=copilot
# only needed if the installation paths are not in the system PATH
# COPILOT_PATH=/usr/local/bin/copilot
# ANTIGRAVITY_PATH=/usr/local/bin/agy

# Database
DB_FILE=storage/db/solomon.db

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
